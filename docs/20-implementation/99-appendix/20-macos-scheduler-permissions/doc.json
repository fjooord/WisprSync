    "b-20-macos-scheduler-permissions-if-macos-blocks-the-sche-19": {
      "id": "b-20-macos-scheduler-permissions-if-macos-blocks-the-sche-19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If macOS blocks the scheduled job, grant privacy access to that app bundle, not to "
        },
        {
          "insert": "/usr/bin/python3",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", Xcode Python, Anaconda Python, or another shared interpreter."
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-this-does-not-create-per-20": {
      "id": "b-20-macos-scheduler-permissions-this-does-not-create-per-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This does not create perfect path-level sandboxing. macOS privacy controls are still process based. The improvement is that the process receiving access is a repo-local WisprSync runner whose only generated command path is "
        },
        {
          "insert": "wisprsync sync",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", backed by a private runtime inside "
        },
        {
          "insert": ".wisprsync/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
