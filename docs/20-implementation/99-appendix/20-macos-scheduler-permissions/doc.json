    "b-20-macos-scheduler-permissions-that-executable-is-a-sma-13": {
      "id": "b-20-macos-scheduler-permissions-that-executable-is-a-sma-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "That executable is a small shell script generated during install. It changes to the repository root and executes the private runtime:"
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-sh-14": {
      "id": "b-20-macos-scheduler-permissions-sh-14",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "exec .wisprsync/runner-venv/bin/python -m wisprsync sync \"$@\""
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-the-private-runtime-is-c-15": {
      "id": "b-20-macos-scheduler-permissions-the-private-runtime-is-c-15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The private runtime is created with Python's standard "
        },
        {
          "insert": "venv",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " module using "
        },
        {
          "insert": "with_pip=False",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "symlinks=False",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". This creates a local Python copy for the scheduled runner without installing package-management tooling into that runtime."
        }
      ],
      "children": []
    },
