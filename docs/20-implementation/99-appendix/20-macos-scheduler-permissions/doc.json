      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "python3 -m wisprsync schedule install",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " creates three local scheduler artifacts:"
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-text-10": {
