      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-the-scheduled-job-needs-5": {
      "id": "b-20-macos-scheduler-permissions-the-scheduled-job-needs-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The scheduled job needs to read the Wispr Flow SQLite database and write the configured export folder. On this machine, those paths are:"
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-text-6": {
      "id": "b-20-macos-scheduler-permissions-text-6",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "~/Library/Application Support/Wispr Flow/flow.sqlite\n~/Library/CloudStorage/Dropbox/wispr_sync"
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-when-launchd-runs-a-he-7": {
      "id": "b-20-macos-scheduler-permissions-when-launchd-runs-a-he-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "When "
        },
        {
          "insert": "launchd",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs a headless job, macOS privacy controls can deny access even when the same command works from an interactive terminal. Granting Full Disk Access to a global Python executable would make every script run by that Python binary inherit broad access, which is too large a trust target for this tool."
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-runtime-shape-8": {
      "id": "b-20-macos-scheduler-permissions-runtime-shape-8",
