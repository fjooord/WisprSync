    "b-20-macos-scheduler-permissions-wisprsync-s-scheduled-ma-2": {
      "id": "b-20-macos-scheduler-permissions-wisprsync-s-scheduled-ma-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync's scheduled macOS sync uses a dedicated local runner instead of a shared Python interpreter. This keeps the permission target narrow when macOS privacy controls gate access to the Wispr Flow database and the configured export folder."
        }
      ],
      "children": []
    },
    "b-20-macos-scheduler-permissions-divider-3": {
      "id": "b-20-macos-scheduler-permissions-divider-3",
