    },
    "b-20-wisprsync-output-shape-parsed-record-shape-4": {
      "id": "b-20-wisprsync-output-shape-parsed-record-shape-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Parsed Record Shape"
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-wisprsync-parses-each-h-5": {
      "id": "b-20-wisprsync-output-shape-wisprsync-parses-each-h-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync parses each "
        },
        {
          "insert": "History",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " row into one canonical record. The record has a structured "
        },
        {
          "insert": "metadata.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", optional text files, optional media files, and a compact row in "
        },
        {
          "insert": "indexes/history.jsonl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-text-6": {
      "id": "b-20-wisprsync-output-shape-text-6",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "record\n├── metadata.json              canonical structured object\n├── raw_transcript.txt         optional text from History.asrText\n├── formatted_transcript.txt   optional text from History.formattedText\n├── audio.wav                  optional bytes from History.audio\n└── screenshot.png             optional bytes from History.screenshot"
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-transcript-option-files-7": {
      "id": "b-20-wisprsync-output-shape-transcript-option-files-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Transcript option files are convenience artifacts for direct search and reading. They contain only the source text value. They do not include labels, separators, or metadata."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-fields-that-are-not-firs-8": {
      "id": "b-20-wisprsync-output-shape-fields-that-are-not-firs-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Fields that are not first-class files stay in "
        },
        {
          "insert": "metadata.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "indexes/history.jsonl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". This includes "
        },
        {
          "insert": "editedText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "pastedText",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", fallback/default transcript variants, app context, URLs, timings, language, quality metadata, and edit metadata."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-metadata-object-9": {
