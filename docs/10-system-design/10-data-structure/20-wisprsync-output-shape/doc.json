    "b-20-wisprsync-output-shape-the-date-folders-come-fr-17": {
      "id": "b-20-wisprsync-output-shape-the-date-folders-come-fr-17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The date folders come from "
        },
        {
          "insert": "History.timestamp",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " normalized to UTC. The record ID comes from "
        },
        {
          "insert": "History.transcriptEntityId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and defines identity. If a timestamp is missing or invalid, the record is placed under:"
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-text-18": {
      "id": "b-20-wisprsync-output-shape-text-18",
      "type": "code",
      "props": {
        "language": "text"
      },
      "text": [
        {
          "insert": "records/unknown/unknown/unknown/unknown-time_{transcriptEntityId}/"
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-indexes-19": {
      "id": "b-20-wisprsync-output-shape-indexes-19",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Indexes"
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-indexes-history-jsonl-20": {
      "id": "b-20-wisprsync-output-shape-indexes-history-jsonl-20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "indexes/history.jsonl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has one compact JSON object per searchable transcript record. It includes current "
        },
        {
          "insert": "History",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rows and previously exported records that are now missing from the source database. Current rows use "
        },
        {
          "insert": "source_status: \"current\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "; retained rows use "
        },
        {
          "insert": "source_status: \"missing_from_source\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and keep the last exported text, metadata path, media paths, and hashes."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-indexes-dictionary-json-21": {
      "id": "b-20-wisprsync-output-shape-indexes-dictionary-json-21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "indexes/dictionary.jsonl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is a full export of the current "
        },
        {
          "insert": "Dictionary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " table. It represents the latest dictionary state for the run rather than an append-only dictionary history."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-indexes-runs-jsonl-app-22": {
      "id": "b-20-wisprsync-output-shape-indexes-runs-jsonl-app-22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "indexes/runs.jsonl",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " appends one compact summary object for each export run."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-manifest-and-run-reports-23": {
      "id": "b-20-wisprsync-output-shape-manifest-and-run-reports-23",
