      "id": "b-20-wisprsync-output-shape-manifest-json-describe-24",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "manifest.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " describes the whole data zone and latest export state: dataset timestamps, source database, counts, date range, index paths, latest run, and top-level integrity hashes."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-each-run-writes-a-full-r-25": {
