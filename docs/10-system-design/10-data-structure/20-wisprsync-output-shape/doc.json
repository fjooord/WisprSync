    "b-20-wisprsync-output-shape-wisprsync-turns-wispr-fl-2": {
      "id": "b-20-wisprsync-output-shape-wisprsync-turns-wispr-fl-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync turns Wispr Flow's local SQLite rows into a canonical "
        },
        {
          "insert": "data/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " folder that is easy to own, search, validate, and load into analysis tools. The output structure is designed around one durable identity, "
        },
        {
          "insert": "History.transcriptEntityId",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with large blobs stored as normal files and query-friendly JSONL indexes generated alongside per-record folders."
        }
      ],
      "children": []
    },
    "b-20-wisprsync-output-shape-divider-3": {
      "id": "b-20-wisprsync-output-shape-divider-3",
