    "b-30-export-targets-wisprsync-does-not-curre-2": {
      "id": "b-30-export-targets-wisprsync-does-not-curre-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync does not currently implement remote targets, webhooks, Git pushes, or provider-specific upload logic. The supported behavior is folder export only."
        }
      ],
      "children": []
    },
    "b-30-export-targets-future-export-targets-sh-3": {
      "id": "b-30-export-targets-future-export-targets-sh-3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Future export targets should be modular layers around the same canonical data shape. The source reader and folder writer establish the base contract; optional future targets can add publishing behavior without changing record contents."
        }
      ],
      "children": []
    },
