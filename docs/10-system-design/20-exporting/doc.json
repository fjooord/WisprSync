    "b-00-overview-the-base-mode-writes-to-8": {
      "id": "b-00-overview-the-base-mode-writes-to-8",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The base mode writes to a user-specified folder. This is the default and should remain the lowest-friction path. For easy cloud backup, the recommended output folder can live inside a normal cloud-synced directory such as Dropbox, iCloud Drive, Google Drive, or OneDrive."
        }
      ],
      "children": []
    },
