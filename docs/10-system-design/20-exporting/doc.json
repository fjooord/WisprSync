      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Exporting writes the canonical WisprSync data tree to a folder the user specifies. If the user wants cloud sync, they can choose a folder already managed by Dropbox, iCloud Drive, Google Drive, OneDrive, or another sync tool."
        }
      ],
      "children": []
