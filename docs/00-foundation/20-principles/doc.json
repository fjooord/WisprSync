    "b-20-principles-wisprsync-is-guided-by-a-2": {
      "id": "b-20-principles-wisprsync-is-guided-by-a-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync is guided by a small set of principles: local data ownership, transparent export formats, and explicit user control over where exported data goes."
        }
      ],
      "children": []
    },
    "b-20-principles-divider-3": {
      "id": "b-20-principles-divider-3",
      "type": "divider",
      "props": {},
      "children": []
    },
