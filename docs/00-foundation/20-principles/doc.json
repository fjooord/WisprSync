        {
          "insert": "Safe Defaults"
        }
      ],
      "children": []
    },
    "b-20-principles-the-exporter-should-avoi-13": {
      "id": "b-20-principles-the-exporter-should-avoi-13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The exporter should avoid raw app folders, cookies, sessions, caches, telemetry files, and local machine config. The canonical export should contain transcript data and related artifacts, not private application runtime state."
        }
      ],
      "children": []
    }
