      "id": "b-20-principles-data-ownership-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Data Ownership"
        }
      ],
      "children": []
    },
    "b-20-principles-if-transcript-data-is-al-5": {
      "id": "b-20-principles-if-transcript-data-is-al-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "If transcript data is already on the user's device, the user should be able to inspect it, back it up, analyze it, and move it into their own workflows."
        }
      ],
      "children": []
    },
    "b-20-principles-local-first-6": {
      "id": "b-20-principles-local-first-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Local First"
        }
      ],
      "children": []
    },
    "b-20-principles-the-base-export-path-wri-7": {
      "id": "b-20-principles-the-base-export-path-wri-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The base export path writes to a folder the user controls. Cloud sync or future remote targets should layer on top of that folder export instead of replacing it."
        }
      ],
      "children": []
    },
    "b-20-principles-transparent-formats-8": {
      "id": "b-20-principles-transparent-formats-8",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Transparent Formats"
        }
      ],
      "children": []
    },
    "b-20-principles-the-export-should-use-pl-9": {
      "id": "b-20-principles-the-export-should-use-pl-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The export should use plain files and documented structures: JSON, JSONL, text files, WAV audio, PNG screenshots, manifests, and run reports."
        }
      ],
      "children": []
    },
    "b-20-principles-explicit-sync-10": {
      "id": "b-20-principles-explicit-sync-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Explicit Sync"
        }
      ],
      "children": []
    },
    "b-20-principles-wisprsync-should-not-com-11": {
      "id": "b-20-principles-wisprsync-should-not-com-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync should not commit, push, upload, or delete exported data unless the user explicitly chooses that behavior."
        }
      ],
      "children": []
    },
    "b-20-principles-safe-defaults-12": {
      "id": "b-20-principles-safe-defaults-12",
