      "id": "b-30-boundaries-not-affiliated-with-wisp-4",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Not Affiliated With Wispr Flow"
        }
      ],
      "children": []
    },
    "b-30-boundaries-wisprsync-is-not-affilia-5": {
      "id": "b-30-boundaries-wisprsync-is-not-affilia-5",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync is not affiliated with, endorsed by, or supported by Wispr Flow. Users run it at their own risk."
        }
      ],
      "children": []
    },
    "b-30-boundaries-not-a-wispr-flow-restore-6": {
      "id": "b-30-boundaries-not-a-wispr-flow-restore-6",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Not A Wispr Flow Restore Tool"
        }
      ],
      "children": []
    },
    "b-30-boundaries-wisprsync-exports-data-o-7": {
      "id": "b-30-boundaries-wisprsync-exports-data-o-7",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync exports data out of local Wispr Flow storage. It does not write data back into Wispr Flow."
        }
      ],
      "children": []
    },
    "b-30-boundaries-not-a-raw-app-data-backu-8": {
      "id": "b-30-boundaries-not-a-raw-app-data-backu-8",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Not A Raw App Data Backup"
        }
      ],
      "children": []
    },
    "b-30-boundaries-wisprsync-should-not-tre-9": {
      "id": "b-30-boundaries-wisprsync-should-not-tre-9",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync should not treat the full Wispr Flow application support folder as the export. Cookies, sessions, caches, telemetry folders, and SQLite source snapshots are outside the canonical export."
        }
      ],
      "children": []
    },
    "b-30-boundaries-not-automatic-publishing-10": {
      "id": "b-30-boundaries-not-automatic-publishing-10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Not Automatic Publishing"
        }
      ],
      "children": []
    },
    "b-30-boundaries-the-base-export-writes-t-11": {
      "id": "b-30-boundaries-the-base-export-writes-t-11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The base export writes to a folder. Git commits, GitHub pushes, object storage uploads, or other remote sync behaviors should be explicit layers."
        }
      ],
      "children": []
    },
    "b-30-boundaries-not-a-permanent-schema-c-12": {
