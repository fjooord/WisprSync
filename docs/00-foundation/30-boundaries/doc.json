    "b-30-boundaries-wisprsync-is-a-local-exp-2": {
      "id": "b-30-boundaries-wisprsync-is-a-local-exp-2",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "WisprSync is a local exporter for data already present on the user's machine. It is not an official Wispr Flow feature, not a cloud API client, and not a restore tool."
        }
      ],
      "children": []
    },
    "b-30-boundaries-divider-3": {
      "id": "b-30-boundaries-divider-3",
      "type": "divider",
      "props": {},
